{
  "name": "bwf-match-schedule",
  "private": true,
  "version": "1.0.1",
  "description": "Fetch BWF tournament match schedule pages and display match times in your local timezone.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/run-vite.mjs dev",
    "build": "tsc -b && vite build",
    "build:extension": "node scripts/build-extension.mjs",
    "build:extension:zip": "node scripts/build-extension.mjs --zip",
    "desktop:dev": "npm run build && electron electron/main.cjs",
    "build:desktop": "npm run build && electron-builder",
    "build:desktop:linux": "npm run build && electron-builder --linux",
    "build:desktop:win": "npm run build && electron-builder --win",
    "build:desktop:mac": "npm run build && electron-builder --mac",
    "build:desktop:mac:zip": "npm run build && electron-builder --mac zip",
    "lint": "oxlint",
    "preview": "node scripts/run-vite.mjs preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.89.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
